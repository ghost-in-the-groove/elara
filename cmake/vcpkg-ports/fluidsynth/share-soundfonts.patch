+        range->ignore = FALSE;
+    }
 
     return !ignore_zone && ((range->keylo <= key) &&
                             (range->keyhi >= key) &&
@@ -2250,11 +2255,15 @@ static int load_preset_samples(fluid_defsfont_t *defsfont, fluid_preset_t *prese
                         if(sffile == NULL)
                         {
                             FLUID_LOG(FLUID_ERR, "Unable to open Soundfont file");
-                            return FLUID_FAILED;
                         }
                     }
 
-                    if(fluid_defsfont_load_sampledata(defsfont, sffile, sample) == FLUID_OK)
+                    /* Without the file, the sample is disabled like one that
+                     * cannot be read, and the preset's other samples are still
+                     * counted, as unload_preset_samples() expects
+                     * (patched for Elara). */
+                    if(sffile != NULL
+                            && fluid_defsfont_load_sampledata(defsfont, sffile, sample) == FLUID_OK)

diff --git a/src/sfloader/fluid_sfont.h b/src/sfloader/fluid_sfont.h
index 56904fb..dc9b3f7 100644
--- a/src/sfloader/fluid_sfont.h
+++ b/src/sfloader/fluid_sfont.h
@@ -56,11 +56,23 @@ fluid_sfont_t *new_fluid_sfont_local(fluid_sfont_get_name_t get_name,
   ( ((_preset) && (_preset)->notify) ? (*(_preset)->notify)(_preset,_reason,_chan) : FLUID_OK )
 
 
-#define fluid_sample_incr_ref(_sample) { (_sample)->refcount++; }
+/* Synthesizers that share a SoundFont start and end voices of the same
+ * samples on different threads, so a sample's count of voices changes
+ * atomically (patched for Elara). */
+#if defined(_MSC_VER)
+#include <intrin.h>
+#define fluid_sample_refcount_add(_sample, _n) \
+  ((unsigned int)_InterlockedExchangeAdd((volatile long *)&(_sample)->refcount, (long)(_n)) \
+   + (unsigned int)(_n))
+#else
+#define fluid_sample_refcount_add(_sample, _n) \
+  __atomic_add_fetch(&(_sample)->refcount, (unsigned int)(_n), __ATOMIC_ACQ_REL)
+#endif
+
+#define fluid_sample_incr_ref(_sample) { (void)fluid_sample_refcount_add(_sample, 1); }
 
 #define fluid_sample_decr_ref(_sample) \
-  (_sample)->refcount--; \
-  if (((_sample)->refcount == 0) && ((_sample)->notify)) \
+  if ((fluid_sample_refcount_add(_sample, -1) == 0) && ((_sample)->notify)) \
     (*(_sample)->notify)(_sample, FLUID_SAMPLE_DONE);
 
 
